# Geocoding
geocoding/

# Geocoding data and sensitive files
geocoding/*.csv
geocoding/*.xlsx
geocoding/*.tsv
geocoding/*.json
geocoding/*.env
geocoding/*.pkl
geocoding/*.pickle
geocoding/*.db
geocoding/*.sqlite
geocoding/*.log
geocoding/~$*.xlsx
geocoding/~$*.xls

# Environment variables
.env
*.csv
*.xlsx
*.tsv

# Python
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Distribution / packaging
dist/
build/
*.egg-info/

# Virtual environment
.venv/
venv/
env/
ENV/

# IDE settings
.vscode/
.idea/

# Output files
*.csv
*.xlsx
*.tsv

# Google Analytics 4 - Keep credentials secret but allow data files
web-analytics/ga4_service_account.json
web-analytics/ga4_config.json

# Allow web analytics data files (exception to global *.csv/*.json rules)
# Must un-ignore directory first, then un-ignore specific files
!web-analytics/
web-analytics/*
!web-analytics/weekly_analytics_*.json
!web-analytics/weekly_web_analytics.csv
!web-analytics/*.png
!web-analytics/*.py
!web-analytics/*.md
!web-analytics/requirements.txt
!web-analytics/archive/

# GitHub Traffic Data - IMPORTANT: These files should be tracked for historical data
# Allow traffic data files (exception to global *.csv rules)
# Must un-ignore directory first, then un-ignore specific files
!traffic-data/
traffic-data/*
!traffic-data/traffic-*.json
!traffic-data/weekly_summary.csv
!traffic-data/*.png
!traffic-data/*.py
!traffic-data/*.md
!traffic-data/archive/