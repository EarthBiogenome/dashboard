{
  "permissions": {
    "allow": [
      "WebFetch(domain:goat.genomehubs.org)",
      "WebFetch(domain:www.earthbiogenome.org)",
      "Bash(gh api repos/EarthBiogenome/dashboard/pages)",
      "WebFetch(domain:earthbiogenome.github.io)",
      "Bash(gh pr view --json number,headRepository)",
      "Bash(where gh)",
      "Bash(claude mcp add github -- npx -y @modelcontextprotocol/server-github)",
      "Bash(claude mcp list)",
      "Edit(/.claude/skills/style-check/**)"
    ],
    "additionalDirectories": [
      "c:\\Users\\fchen13\\ASU Dropbox\\Fang Chen\\Work Documents\\EBP\\Dashboard reports\\.claude\\skills\\style-check"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); FILE=$(echo \"$INPUT\" | python -c \"import sys,json; d=json.load(sys.stdin); ti=d.get('tool_input',{}); print(ti.get('file_path',ti.get('notebook_path','')))\" 2>/dev/null); [ -n \"$FILE\" ] && case \"$FILE\" in *.py) python -m py_compile \"$FILE\" && echo \"Python syntax OK: $FILE\";; esac"
          }
        ]
      }
    ]
  },
  "cleanupPeriodDays": 180
}
